{
  "name": "mox-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ui:studio": "pnpm --filter @mox/web run ui:studio",
    "mox:bootstrap-admin": "node packages/database/scripts/bootstrap-admin.mjs",
    "build": "pnpm -r --filter @mox/* run build",
    "typecheck": "pnpm -r --filter @mox/* run typecheck",
    "lint": "oxlint packages apps services runtime infra",
    "public-branding-scan": "node scripts/public-branding-scan.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "container-builds": "node scripts/container-builds.mjs",
    "dependency-security": "pnpm audit --audit-level high",
    "test": "vitest run",
    "e2e": "playwright test",
    "scan:authority": "node scripts/authority-scan.mjs",
    "quality": "pnpm public-branding-scan && pnpm secret-scan && pnpm dependency-security && pnpm scan:authority && pnpm typecheck && pnpm test",
    "baseline:checks": "scripts\\baseline-checks.cmd"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
