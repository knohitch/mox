    "scan:authority": "node scripts/authority-scan.mjs",
    "baseline:checks": "scripts\\baseline-checks.cmd"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}